# ==============================================================================
# DermAI Environment Configuration
# DISCLAIMER: Educational & Clinical Decision-Support Tool - NOT Medical Diagnosis
# ==============================================================================

# Application Environment (development / production)
ENVIRONMENT=development

# ------------------------------------------------------------------------------
# PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
POSTGRES_USER=dermai_user
POSTGRES_PASSWORD=dermai_password
POSTGRES_DB=dermai_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://dermai_user:dermai_password@localhost:5432/dermai_db

# ------------------------------------------------------------------------------
# MinIO (S3-Compatible Object Storage) Configuration
# ------------------------------------------------------------------------------
# MinIO root login credentials (access key & secret key)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# MinIO API Port (S3 client requests) and Web Console Port (Browser GUI)
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=localhost:9000
MINIO_BUCKET_NAME=dermai-images
MINIO_USE_SSL=false

# ------------------------------------------------------------------------------
# JWT Authentication & Security
# ------------------------------------------------------------------------------
# In production, generate a secure key with: openssl rand -hex 32
SECRET_KEY=supersecretkey_change_in_production_1234567890abcdef
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ------------------------------------------------------------------------------
# AI Inference & Clinical Decision Support Configuration
# ------------------------------------------------------------------------------
MODEL_PATH=ml/experiments/resnet50_smoke/best.pt
MODEL_VERSION=smoke-test
DEMO_MODEL=true
CONFIDENCE_THRESHOLD=0.60
ENABLE_SEGMENTATION=true
SEGMENTATION_MODEL_PATH=ml/experiments/segmentation_smoke/best_model.pth
GRADCAM_ENABLED=true
RISK_SCORING_ENABLED=true
ENSEMBLE_MODELS=

# ------------------------------------------------------------------------------
# Redis Cache Configuration
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_CACHE_TTL=3600
